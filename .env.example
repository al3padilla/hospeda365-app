# Firebase Console > Project settings > Your apps > Web app > Config.
# Public client identifiers; never use service-account keys or OAuth client secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hospeda365-ee59d.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hospeda365-ee59d
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hospeda365-ee59d.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=515368888697

# Google Cloud > APIs & Services > Credentials, in the SAME Firebase project.
# WEB client ID (type Web application), also used as the native token audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Required only for iOS (type iOS). The URL scheme is derived automatically.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Must match the registered apps; set before building. Android also needs SHA-1.
GOOGLE_ANDROID_PACKAGE=com.hospeda365.app
GOOGLE_IOS_BUNDLE_IDENTIFIER=com.hospeda365.app
